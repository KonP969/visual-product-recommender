# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Opcjonalnie: OpenRouter zamiast bezpośredniego Google API (bez dziennych
# limitów free tier; koszt ~0,2 gr/wyszukiwanie). Gdy ustawione, ma priorytet.
# Klucz: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
